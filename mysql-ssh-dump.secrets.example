# mysql-ssh-dump.secrets
# Secrets for mysql-ssh-dump.sh. Never commit to Git.
# Location: SECRETS_FILE from the config (directory chmod 700, file chmod 600, root:root).
# Values are sourced by bash. Always use single quotes: nothing inside them is
# interpreted ($, backticks, backslash). A single quote inside a value is
# written as '\'' (end quote, escaped quote, start quote).

# SSH password. Required unless SSH_KEY is set in the config.
SSH_PASSWORD='changeme'

# Database passwords, key = label from DB_LIST in the config
declare -A DB_PASSWORDS=(
    ["site1"]='changeme1'
    ["site2"]='changeme2'
)
